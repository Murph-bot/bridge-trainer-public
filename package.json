{
  "name": "bridge-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:node": "node scripts/build-node.mjs",
    "eval:leads": "node scripts/build-node.mjs && tsx scripts/eval-leads.ts",
    "smoke": "node scripts/smoke.mjs",
    "eval:group": "tsx scripts/group-disagreements.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "eval:calibrate": "npm run eval:leads && npm run calibrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "bridge-dds": "1.4.0"
  }
}
